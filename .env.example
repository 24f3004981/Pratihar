# Google Gemini (the receptionist's brain, the job card, the judge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs (speech to text, text to speech, phone agent)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Default voice: "Pyaari", young Hinglish female voice
ELEVENLABS_VOICE_ID=EHeVIpHOvJGuhp2QcMZZ

# MongoDB Atlas. Leave empty in dev and an in-memory Mongo starts for you.
MONGODB_URI=
MONGODB_DB=pratihar

# TigerData (TimescaleDB) for call analytics. Leave empty to compute from Mongo instead.
TIGER_DATABASE_URL=

# Meko (knowledge base + caller memory over MCP)
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
MEKO_DATAPACK_ID=

# Public URL (needed for ElevenLabs phone tools and the embed widget)
PUBLIC_URL=http://localhost:3000
# Secret used to sign booking IDs so forged ones fail verification
BOOKING_SECRET=change-me
# Shared secret ElevenLabs sends to /api/tools, so only your phone agent can book
TOOLS_SECRET=
